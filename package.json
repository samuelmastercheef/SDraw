{
  "name": "sdrawai",
  "productName": "Sdraw AI",
  "version": "3.13.0",
  "description": "Sdraw AI: phần mềm thiết kế nội thất, gợi ý mẫu từ kho mẫu 3D trên máy, bố trí 2D, bảng kê và xuất bản vẽ",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": {
    "name": "Socin",
    "url": "https://socin.org"
  },
  "homepage": "https://socin.org",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.0.8",
    "@types/three": "^0.187.0",
    "exceljs": "^4.4.0",
    "konva": "^9.3.14",
    "manifold-3d": "^3.5.4",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  },
  "build": {
    "appId": "org.socin.sdrawai",
    "productName": "Sdraw AI",
    "files": [
      "out/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "build/icon.png"
    },
    "afterPack": "scripts/mac-adhoc-sign.cjs"
  }
}
